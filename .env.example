# Naukri AutoAI example configuration — copy to .env and fill in real values.
# NEVER commit your real .env file.

# Naukri credentials (required)
NAUKRI_EMAIL="you@example.com"
NAUKRI_PASSWORD="your_naukri_password"

# Groq API (required)
GROQ_API_KEY="gsk_your_groq_key"
GROQ_MODEL="openai/gpt-oss-120b"
LLM_TEMPERATURE=0.3

# Daily limit
DAILY_APPLY_LIMIT=49
MAX_BATCH_SIZE=5
MAX_EXPERIENCE_YEARS=10

# Role preference order: the bot ticks earlier roles first (⭐ preferred),
# and falls back to later roles only when preferred ones run out.
# Automation roles first, manual testing roles next, broad analyst roles last.
PREFERRED_ROLES=Senior QA Automation Engineer, SDET, Automation Test Engineer, QA Automation Engineer, Software Test Engineer, API Automation Engineer, Test Automation Engineer, Senior QA Engineer, Software Quality Engineer, Quality Assurance Engineer, API Automation Tester, QA Engineer, Selenium Automation Engineer, Java Automation Tester, Playwright Automation Engineer, API Test Engineer, Performance Test Engineer, Functional Test Engineer, Manual and Automation Tester, Web Automation Tester, Mobile Application Test Engineer, Test Analyst, Manual Test Engineer, Manual QA Engineer, Manual Tester, Manual Functional Tester, QA Tester, Test Engineer

# Preferred locations (comma-separated); used by the job-search fallback
PREFERRED_LOCATIONS=Indore, Remote

# Browser
HEADLESS=false
SLOW_MO_MS=60
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
STORAGE_STATE_PATH=storage_state.json

# Cache
DB_PATH=data/db.json
LLM_CACHE_DB_PATH=naukri_autoai_memory.db
SEMANTIC_CACHE_THRESHOLD=0.85

# Diagnostics
DIAGNOSTICS_DIR=data/diagnostics
SCREENSHOT_ON_ERROR=true

# Optional notifications (email via SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Approval gate / dry run (optional)
REQUIRE_APPROVAL=false
DRY_RUN=false
